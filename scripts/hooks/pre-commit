#!/usr/bin/env python3
"""
Pre-commit guard for SurfaceScanner (EAS).

Blocks client data, personal information and secrets from entering the repo at
the one moment code and data can merge: the commit. It scans only the lines this
commit adds, and it fails the commit with the offending file and line listed. It
narrates nothing after the fact, it stops the leak before it happens.

What it blocks in added lines:
  - secrets (private keys, cloud keys, tokens, high-signal secret assignments)
  - personal email addresses (any domain not in the allowlist)
  - public IP addresses (private, loopback and documentation ranges are fine)
  - any client name listed in an EXTERNAL denylist kept outside the repo

The client-name denylist is deliberately NOT stored in the repo. Putting real
client names in a tracked file would re-introduce exactly what this guard exists
to keep out. The guard loads the denylist from the first of these that exists:
  - $SS_CLIENT_DENYLIST
  - $SURFACESCANNER_DATA/client-denylist.txt
  - ~/.config/surfacescanner/client-denylist.txt
One client name or regex per line, blank lines and lines starting with # ignored.

Allowlist (tracked, generic only): scripts/hooks/allowlist.txt. A flagged line
that contains an allowlist token is cleared.

Escape hatch for a deliberate, reviewed commit:
  SS_GUARD_SKIP=1 git commit ...     or     git commit --no-verify
Use it only when you are certain the match is a false positive.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

if os.environ.get("SS_GUARD_SKIP") == "1":
    sys.exit(0)

REPO = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
)

# Secrets: high-signal, low false positive.
SECRET_PATTERNS = [
    (re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"), "private key"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    (re.compile(r"\bASIA[0-9A-Z]{16}\b"), "AWS temporary key id"),
    (re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b"), "Google API key"),
    (re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b"), "Slack token"),
    (re.compile(r"\bgh[pousr]_[0-9A-Za-z]{36,}\b"), "GitHub token"),
    (re.compile(r"\bsk-[0-9A-Za-z]{20,}\b"), "generic sk- secret"),
    (re.compile(r"\beyJ[0-9A-Za-z_\-]{10,}\.[0-9A-Za-z_\-]{10,}\.[0-9A-Za-z_\-]{10,}"), "JWT"),
    (re.compile(r"(?i)\b(?:api[_-]?key|secret|passwd|password|token)\b\s*[:=]\s*['\"][^'\"]{8,}['\"]"), "secret assignment"),
]

EMAIL = re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b")
IPV4 = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")

# An "email" whose domain ends in one of these is a systemd unit instance name
# (unit@instance.service), not an address.
SYSTEMD_SUFFIXES = (
    ".service", ".timer", ".socket", ".target", ".path", ".device", ".scope",
    ".slice", ".mount", ".automount", ".swap",
)
# TLDs reserved for documentation and tests (RFC 2606 / 6761). Addresses under
# them are never real.
RESERVED_TLDS = (".example", ".test", ".invalid", ".localhost")


class Allow:
    def __init__(self):
        self.emails: set[str] = set()
        self.domains: set[str] = set()
        self.ips: set[str] = set()
        self.tokens: set[str] = set()   # literal secret-like strings to clear
        self.skips: list[str] = []      # path globs: skip ip+email checks there


def _allowlist() -> Allow:
    a = Allow()
    f = REPO / "scripts" / "hooks" / "allowlist.txt"
    if not f.exists():
        return a
    for line in f.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" in line.split()[0]:
            kind, _, rest = line.partition(":")
            rest = rest.strip()
            if kind == "email":
                a.emails.add(rest.lower())
            elif kind == "domain":
                a.domains.add(rest.lower().rstrip("."))
            elif kind == "ip":
                a.ips.add(rest)
            elif kind == "token":
                a.tokens.add(rest)
            elif kind == "skip":
                a.skips.append(rest)
            continue
        # backward-compatible bare lines
        if "@" in line:
            a.emails.add(line.lower())
        else:
            a.domains.add(line.lower().rstrip("."))
    return a


def _skip_path(path: str, skips: list[str]) -> bool:
    import fnmatch
    for g in skips:
        if g.endswith("/") and path.startswith(g):
            return True
        if fnmatch.fnmatch(path, g):
            return True
    return False


def _denylist() -> list[re.Pattern]:
    candidates = [
        os.environ.get("SS_CLIENT_DENYLIST"),
        (os.environ.get("SURFACESCANNER_DATA") or "") + "/client-denylist.txt",
        str(Path.home() / ".config" / "surfacescanner" / "client-denylist.txt"),
    ]
    for c in candidates:
        if not c:
            continue
        p = Path(c)
        if p.exists():
            pats = []
            for line in p.read_text().splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    pats.append(re.compile(re.escape(line), re.IGNORECASE))
            return pats
    return []  # absent: see the warning printed at the end


def _is_public_ip(ip: str) -> bool:
    try:
        octs = [int(x) for x in ip.split(".")]
    except ValueError:
        return False
    if len(octs) != 4 or any(o > 255 for o in octs):
        return False
    a, b = octs[0], octs[1]
    if a in (0, 10, 127):                       # this-host, private, loopback
        return False
    if a == 172 and 16 <= b <= 31:              # private
        return False
    if a == 192 and b == 168:                   # private
        return False
    if a == 169 and b == 254:                   # link-local
        return False
    if a == 192 and b == 0 and octs[2] == 2:    # documentation TEST-NET-1
        return False
    if a == 198 and b == 51 and octs[2] == 100:  # documentation TEST-NET-2
        return False
    if a == 203 and b == 0 and octs[2] == 113:  # documentation TEST-NET-3
        return False
    if a == 198 and b in (18, 19):              # benchmarking
        return False
    if 224 <= a <= 239:                         # multicast
        return False
    if a >= 240:                                # reserved
        return False
    if a == 100 and 64 <= b <= 127:             # CGNAT
        return False
    return True


def staged_added_lines():
    """Yield (path, added_text) for lines this commit adds."""
    diff = subprocess.run(
        ["git", "diff", "--cached", "--unified=0", "--no-color",
         "--diff-filter=ACM"],
        capture_output=True, text=True,
    ).stdout
    path = None
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            path = line[6:]
        elif line.startswith("+") and not line.startswith("+++"):
            if path is not None:
                yield path, line[1:]


def _email_allowed(addr: str, a: Allow) -> bool:
    addr = addr.lower()
    dom = addr.split("@", 1)[1]
    if dom.endswith(SYSTEMD_SUFFIXES):       # unit@instance.service, not an email
        return True
    if dom.endswith(RESERVED_TLDS):          # reserved doc/test TLDs
        return True
    if addr in a.emails:
        return True
    return any(dom == d or dom.endswith("." + d) for d in a.domains)


def main() -> int:
    a = _allowlist()
    deny = _denylist()
    findings: list[str] = []

    for path, text in staged_added_lines():
        for rx, label in SECRET_PATTERNS:
            m = rx.search(text)
            if m and m.group(0) not in a.tokens:
                findings.append(f"{path}: secret ({label})")

        for pat in deny:
            if pat.search(text):
                findings.append(f"{path}: client name on denylist ({pat.pattern})")

        if _skip_path(path, a.skips):
            continue  # data file: secrets and denylist still checked above, skip ip/email

        for em in EMAIL.finditer(text):
            if not _email_allowed(em.group(0), a):
                findings.append(f"{path}: email address ({em.group(0)})")

        for ip in IPV4.finditer(text):
            if _is_public_ip(ip.group(0)) and ip.group(0) not in a.ips:
                findings.append(f"{path}: public IP ({ip.group(0)})")

    if findings:
        sys.stderr.write(
            "\nPRE-COMMIT GUARD blocked this commit. Possible client data, PII or secrets:\n\n"
        )
        for f in dict.fromkeys(findings):  # de-dupe, keep order
            sys.stderr.write(f"  - {f}\n")
        sys.stderr.write(
            "\nFix: move the data to SURFACESCANNER_DATA, genericise it, or add a\n"
            "generic token to scripts/hooks/allowlist.txt if it is a true false positive.\n"
            "Deliberate, reviewed override: SS_GUARD_SKIP=1 git commit ... or git commit --no-verify\n\n"
        )
        return 1

    if not deny:
        sys.stderr.write(
            "pre-commit guard: no client-name denylist found (patterns and secrets still checked).\n"
            "Create one outside the repo to also block client names, for example:\n"
            "  $SURFACESCANNER_DATA/client-denylist.txt  (one name per line)\n"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
