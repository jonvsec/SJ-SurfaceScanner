# ============================================================
# SurfaceScanner environment variables
# Copy to .env and fill values. Never commit .env to git.
# ============================================================

# Code root. The repo or install dir. Only code assets live here.
SURFACESCANNER_ROOT=/opt/surfacescanner
# Data root. Engagement data (scopes, outputs, reports, logs, signals, state)
# lives OUTSIDE the code tree, one directory per client under engagements/.
# Set this equal to SURFACESCANNER_ROOT to restore an in-tree layout.
SURFACESCANNER_DATA=/var/lib/surfacescanner
SURFACESCANNER_TMP=/tmp/surfacescanner

# ── Lookalike vertical ───────────────────────────────────────
# No API keys are required. Discovery uses public sources (crt.sh, CertStream)
# and DNS/RDAP. Everything below is optional and only widens coverage.

# Optional: a self-hosted CertStream server (defaults to the public one in config)
# CERTSTREAM_URL=wss://your-certstream:4443/

# Operator console (tools/panel.py), read-only.
# Local demo login. Keep real values only in .env, never here.
PANEL_USER=redteam
PANEL_PASSWORD=change-me-in-dotenv
PANEL_SECRET=set-a-long-random-value-to-keep-sessions-across-restarts
# Production: set PANEL_SSO=1 to disable the local login and trust the SSO
# proxy header instead (Microsoft Entra in front of oauth2-proxy). See
# deploy/panel-sso.md. Only this email domain is allowed.
# PANEL_SSO=1
PANEL_EMAIL_DOMAIN=yourcompany.com
