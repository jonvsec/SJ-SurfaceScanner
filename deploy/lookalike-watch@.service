# SurfaceScanner lookalike watcher, cadence (single-shot) service.
#
# Templated by scope name. Enable one instance per engagement, where the
# instance name is the scope file stem. Example, for a scope at
# $SURFACESCANNER_DATA/scopes/acme.yaml, enable lookalike-watch@acme.
#
# This runs one cycle and exits. The paired .timer drives the cadence.
#
# Install as a user unit:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/lookalike-watch@.service deploy/lookalike-watch@.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lookalike-watch@acme.timer

[Unit]
Description=SurfaceScanner lookalike watcher for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Point WorkingDirectory and EnvironmentFile at your install. The .env sets
# SURFACESCANNER_ROOT, SURFACESCANNER_DATA and SURFACESCANNER_TMP.
WorkingDirectory=/opt/surfacescanner
EnvironmentFile=/opt/surfacescanner/.env
# Scopes live under the data root, never in the code tree. systemd expands
# ${SURFACESCANNER_DATA} from the EnvironmentFile above.
ExecStart=/opt/surfacescanner/.venv/bin/python tools/lookalike_watch.py --scope ${SURFACESCANNER_DATA}/scopes/%i.yaml --once
Nice=10
# Give DNS and dnstwist room, a cycle can take a few minutes.
TimeoutStartSec=3600
